# ─── Clerk (authentication) ─────────────────────────────────────────────
# Sign up at https://clerk.com, create an app, and paste keys here.
# Then wrap the app in <ClerkProvider> in src/app/layout.tsx and add middleware.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Supabase (database / cross-device progress) ────────────────────────
# Create a project at https://supabase.com and copy the values from
# Project Settings → API. See README → "Wiring up Clerk + Supabase".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Mentor (Google Gemini / Anthropic Claude) ──────────────────────
# The mentor works out-of-the-box offline (built-in beginner-friendly answers).
# Set your Google Gemini API key or OAuth token to enable real-time AI mentoring:
GOOGLE_GEMINI_API_KEY=
# Optional: override default Gemini model (defaults to Flash-Lite: gemini-2.0-flash-lite)
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional fallback LLM: Anthropic Claude
ANTHROPIC_API_KEY=
